<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background_gradient_large">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSS Storage"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your inventory at a glance"
                android:textColor="@android:color/white"
                android:alpha="0.8"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@android:color/white"
            android:alpha="0.3" />

    </LinearLayout>

    <!-- Stats Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <!-- Containers Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/total_containers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Containers"
                android:textColor="@android:color/white"
                android:alpha="0.9"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Items Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/stat_card_background"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/total_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items"
                android:textColor="@android:color/white"
                android:alpha="0.9"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Breakdown -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By Type"
        android:textColor="@android:color/white"
        android:alpha="0.9"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/box_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 boxes"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:background="@drawable/type_chip_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/bag_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 bags"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:background="@drawable/type_chip_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/drawer_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 drawers"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:background="@drawable/type_chip_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
